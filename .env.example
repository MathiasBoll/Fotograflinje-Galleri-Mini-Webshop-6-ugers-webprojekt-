# Environment Variables Configuration
# Copy this file to .env.local and update with your actual values

# Email Service Configuration
# Leave empty for demo mode (emails logged to console and localStorage)
# For production, set this to your backend email API endpoint
VITE_EMAIL_API_URL=

# Example for production:
# VITE_EMAIL_API_URL=https://your-backend.com/api/send-email

# Backend API URLs (if different from default)
# VITE_API_BASE_URL=https://photobooth-lx7n9.ondigitalocean.app

# Feature Flags
# VITE_ENABLE_EMAIL_NOTIFICATIONS=true
